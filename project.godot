; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="flippin_hell"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"

[autoload]

SoundManager="*res://singletons/sound_manager.gd"
SignalManager="*res://singletons/signal_manager.gd"
ScoreManager="*res://singletons/score_manager.gd"
GameManager="*res://singletons/game_manager.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=600
window/size/window_width_override=2048
window/size/window_height_override=1200
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="/Users/gavincampbell/Desktop/Godot/Movies/movie.avi"

[editor_plugins]

enabled=PackedStringArray()

[global_group]

Moveables=""
Player=""

